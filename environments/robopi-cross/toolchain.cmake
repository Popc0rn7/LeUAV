# SDK and architecture are explicit inputs; never resolve target packages on PC.
if(NOT DEFINED ENV{OHOS_SDK} OR NOT DEFINED ENV{OHOS_ARCH})
  message(FATAL_ERROR "OHOS_SDK and OHOS_ARCH must be explicit")
endif()
set(OHOS_ARCH "$ENV{OHOS_ARCH}" CACHE STRING "OHOS target architecture")
set(OHOS_STL c++_shared CACHE STRING "OHOS C++ runtime")
include("$ENV{OHOS_SDK}/build/cmake/ohos.toolchain.cmake")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
if(DEFINED ENV{OHOS_TARGET_PREFIX})
  list(APPEND CMAKE_FIND_ROOT_PATH "$ENV{OHOS_TARGET_PREFIX}")
  list(APPEND CMAKE_PREFIX_PATH "$ENV{OHOS_TARGET_PREFIX}")
endif()
